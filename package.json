{
  "name": "taskmap",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "all"
  },
  "scripts": {
    "postinstall": "node scripts/apply-liquid-dom-webview2-patch.mjs",
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1 --port 1420",
    "dev:phase2": "vite --mode phase2 --config config/vite.config.ts --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit -p config/tsconfig.json && vite build --config config/vite.config.ts",
    "build:phase2": "tsc --noEmit -p config/tsconfig.json && vite build --mode phase2 --config config/vite.config.ts",
    "typecheck": "tsc --noEmit -p config/tsconfig.json",
    "lint": "eslint --config config/eslint.config.js . --max-warnings 0",
    "format": "prettier --write . --ignore-path config/prettierignore",
    "format:check": "prettier --check . --ignore-path config/prettierignore",
    "test": "vitest run --config config/vite.config.ts",
    "test:watch": "vitest --config config/vite.config.ts",
    "app:dev": "tauri dev --features phase2-development --config src-tauri/tauri.dev.conf.json",
    "app:stable": "tauri dev",
    "bundle:dev": "tauri build --features phase2-development --config src-tauri/tauri.dev.conf.json",
    "bundle:stable": "tauri build",
    "architecture:check": "node scripts/check-architecture.mjs",
    "production:inspect": "node scripts/check-phase2-production-exclusion.mjs",
    "codemap": "node scripts/generate-codemap.mjs",
    "codemap:check": "node scripts/generate-codemap.mjs --check",
    "filesizes": "node scripts/report-file-sizes.mjs",
    "fixtures:baseline": "node scripts/generate-baseline-fixtures.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run architecture:check && npm run build && npm run production:inspect",
    "tauri": "tauri"
  },
  "dependencies": {
    "@liquid-dom/core": "0.1.1",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.34.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "immer": "^11.1.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
