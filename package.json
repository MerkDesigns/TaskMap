{
  "name": "taskmap",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "all"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1 --port 6969",
    "dev:storage-preview": "vite --mode storage-preview --config config/vite.config.ts --host 127.0.0.1 --port 6971",
    "app:preview:mcp": "tauri dev --features storage-free-preview,mcp-development --config src-tauri/tauri.storage-preview.conf.json",
    "preview:app": "vite build --config config/vite.config.ts && vite preview --config config/vite.config.ts --host 127.0.0.1 --port 6969 --strictPort",
    "build": "tsc --noEmit -p config/tsconfig.json && vite build --config config/vite.config.ts",
    "typecheck": "tsc --noEmit -p config/tsconfig.json",
    "lint": "eslint --config config/eslint.config.js . --max-warnings 0",
    "format": "prettier --write . --ignore-path config/prettierignore",
    "format:check": "prettier --check . --ignore-path config/prettierignore",
    "test": "vitest run --config config/vite.config.ts",
    "test:watch": "vitest --config config/vite.config.ts",
    "app:dev": "node scripts/dev-app.mjs --config src-tauri/tauri.dev.conf.json",
    "app:dev:mcp": "node scripts/dev-app.mjs --features mcp-development --config src-tauri/tauri.mcp.dev.conf.json",
    "app:dev:devtools": "node scripts/dev-app.mjs --devtools-port 9333 --features mcp-development --config src-tauri/tauri.mcp.dev.conf.json",
    "app:profile:mcp": "node scripts/dev-app.mjs --features mcp-development --config src-tauri/tauri.mcp.dev.conf.json --config src-tauri/tauri.profile.conf.json",
    "app:ui-lab": "npm run app:dev:mcp",
    "app:stable": "node scripts/dev-app.mjs",
    "bundle:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "bundle:stable": "tauri build",
    "installer:web": "vite --config config/vite.installer.config.ts",
    "installer:web:build": "vite build --config config/vite.installer.config.ts",
    "installer:dev": "cd installer && tauri dev --features mcp-development --config tauri.mcp.dev.conf.json",
    "installer:build": "node scripts/build-installer.mjs",
    "migrate-legacy": "vite build --config config/vite.migrator.config.ts && cargo build --release --quiet --manifest-path tools/legacy-migrator/writer/Cargo.toml && node tools/legacy-migrator/migrate.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "production:inspect": "node scripts/check-production-exclusion.mjs && node scripts/check-mcp-development-exclusion.mjs && node scripts/check-application-database-boundary.mjs && node scripts/check-storage-preview.mjs && node scripts/check-database-cutover.mjs && node scripts/check-window-config.mjs",
    "filesizes": "node scripts/report-file-sizes.mjs",
    "fixtures:baseline": "node scripts/generate-baseline-fixtures.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run architecture:check && npm run build && npm run production:inspect",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.34.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "immer": "^11.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
