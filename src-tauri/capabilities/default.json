{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-content-protected",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "process:default",
    "updater:default",
    "dialog:allow-open"
  ]
}
