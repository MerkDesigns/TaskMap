{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskMap Beta",
  "identifier": "com.merkdesigns.taskmap.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default", "application-database", "mcp-development"]
    },
    "windows": [
      {
        "title": "taskmap",
        "decorations": false,
        "resizable": true
      }
    ]
  },
  "plugins": { "updater": { "endpoints": [] } },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
