{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskMap Beta",
  "identifier": "com.merkdesigns.taskmap.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "capabilities": ["default", "application-database"]
    },
    "windows": [
      {
        "title": "taskmap",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0b0b0c"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
