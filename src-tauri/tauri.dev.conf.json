{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskMap Dev",
  "identifier": "com.merkdesigns.taskmap.dev",
  "build": {
    "beforeDevCommand": "npm run dev:phase2",
    "beforeBuildCommand": "npm run build:phase2"
  },
  "app": {
    "security": {
      "capabilities": ["default", "phase2-development"]
    },
    "windows": [
      {
        "title": "taskmap",
        "additionalBrowserArgs": "--enable-features=CanvasDrawElement --enable-blink-features=CanvasDrawElement --enable-experimental-web-platform-features"
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
