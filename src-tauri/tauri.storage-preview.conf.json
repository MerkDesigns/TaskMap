{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskMap Storage-Free Preview",
  "identifier": "com.merkdesigns.taskmap.storage-preview",
  "build": {
    "beforeDevCommand": "npm run dev:storage-preview",
    "devUrl": "http://127.0.0.1:6971/storage-preview.html"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["storage-free-preview", "mcp-development"],
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:6971; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "TaskMap Preview — nothing is saved",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "resizable": true
      }
    ]
  },
  "bundle": { "active": false, "createUpdaterArtifacts": false },
  "plugins": { "updater": null }
}
