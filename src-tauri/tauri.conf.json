{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskMap",
  "version": "0.1.6",
  "identifier": "com.taskmap.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaskMap",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MerkDesigns/TaskMap/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMEM4OUNGMkUxQTkxODMKUldTRGtSb3V6NGtNNFg4WS9DQmNzSTJNMGpyT1BSNUJoR0RvaHcvazhHUXVHNCswc1FEU0xzNzgK"
    }
  }
}
